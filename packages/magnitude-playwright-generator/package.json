{
  "name": "magnitude-playwright-generator",
  "version": "0.1.0",
  "description": "AI-powered Playwright test suite generator using Magnitude",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "bin": {
    "magnitude-generate-tests": "dist/cli.js"
  },
  "exports": {
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsc && pkgroll",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "testing",
    "test-generation",
    "magnitude",
    "ai",
    "automation"
  ],
  "author": {
    "name": "Magnitude",
    "email": "founders@magnitude.run",
    "url": "https://magnitude.run"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "magnitude-core": "workspace:*",
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "mailinator-client": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "pkgroll": "^2.15.4",
    "typescript": "^5.8.3"
  }
}
